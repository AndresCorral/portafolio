---
const { project, index, total, lang } = Astro.props;
const content = project[lang];
const prefix = lang === 'es' ? '/es' : '';
const featured = index === 0;
const isLast = index === total - 1 && index > 1;
const sizeClass = isLast ? 'span-6' : index <= 1 ? 'span-3' : 'span-2';
const tags = project.stack.slice(0, featured ? 4 : 3);
const extra = project.stack.length - tags.length;
---

<a href={prefix + '/projects/' + project.slug} class:list={['project-card', sizeClass, { dark: featured }]}>
  <div class="project-top">
    <span class="mono num">{String(index + 1).padStart(2, '0')}</span>
    <span class="mono">{project.year}</span>
  </div>
  <div class="project-body">
    <h2 class="project-title">{content.title}</h2>
    <p class="project-desc">{content.description}</p>
  </div>
  <div class="project-foot">
    <div class="project-stack">
      {tags.map(s => <span class="pill">{s}</span>)}
      {extra > 0 && <span class="pill">+{extra}</span>}
    </div>
    <span class="mono cta">{project.role[lang]} <span class="arrow" aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .project-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 300px;
    color: var(--color-text);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -20px rgba(18, 19, 20, 0.35);
    color: var(--color-text);
  }
  .project-card:hover .arrow {
    transform: translate(4px, -4px);
  }
  .project-card.dark {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #F3F0E8;
    min-height: 380px;
  }
  .project-card.dark:hover {
    color: #F3F0E8;
  }
  .span-6 {
    grid-column: span 6;
  }
  .span-3 {
    grid-column: span 3;
  }
  .span-2 {
    grid-column: span 2;
  }
  .project-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted-strong);
  }
  .project-card.dark .project-top,
  .project-card.dark .cta {
    color: #A8A59B;
  }
  .project-card.dark .num {
    color: var(--color-accent);
  }
  .project-body {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .project-title {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .project-card.dark .project-title {
    font-size: 40px;
    line-height: 1.05;
  }
  .project-desc {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .span-6 .project-desc {
    max-width: 720px;
  }
  .project-card.dark .project-desc {
    font-size: 18px;
    color: #C9C6BC;
    max-width: 520px;
  }
  .project-foot {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .project-card.dark .pill {
    border-color: #3A3C40;
    color: #F3F0E8;
  }
  .cta {
    color: var(--color-muted-strong);
  }
  .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  @media (max-width: 860px) {
    .span-6,
    .span-3,
    .span-2 {
      grid-column: span 1;
    }
    .project-card {
      padding: 24px;
    }
  }
</style>
