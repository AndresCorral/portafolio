---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import { about } from '../data/about';
import { getProjectBySlug } from '../data/projects';

const { lang, t } = Astro.props;
const c = about[lang];
const prefix = lang === 'es' ? '/es' : '';
const mail = (subject) => `mailto:${about.email}?subject=${encodeURIComponent(subject)}`;
const projectTitle = (slug) => getProjectBySlug(slug)?.[lang]?.title ?? '';
---

<BaseLayout title={c.title} description={c.description}>
  <Nav {t} lang={lang} />
  <main class="about-page">
    <div class="container">
      <a href={prefix + '/#about'} class="back-link">← {c.back}</a>

      <!-- Hero -->
      <header class="hero-block">
        <div class="hero-text">
          <span class="section-label">{c.label}</span>
          <p class="status"><span class="dot" aria-hidden="true"></span>{t['hero.status']}</p>
          <h1 class="headline">{c.headline}</h1>
          <p class="lead">{c.intro}</p>
          <div class="cta-row">
            <a href={mail(c.mailSubject)} class="btn btn-accent">{c.ctaPrimary} <span aria-hidden="true">→</span></a>
            <a href={c.cvHref} class="btn" download>↓ {c.ctaCv}</a>
          </div>
        </div>
        <div class="hero-photo">
          <div class="photo-frame">
            <img src="/images/profile.png" alt="Andrés Corral" class="photo" />
          </div>
          <div class="photo-badge">{t['about.badge']}</div>
        </div>
      </header>

      <!-- Proof strip -->
      <section class="stats-block" aria-label={c.statsSource}>
        <div class="stats-grid">
          {c.stats.map((s) => (
            <a href={prefix + '/projects/' + s.project} class="stat">
              <span class="stat-value">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </a>
          ))}
        </div>
        <p class="stats-source mono">{c.statsSource}</p>
      </section>

      <!-- Pick your bottleneck -->
      <section class="block pick" id="pick" data-pick>
        <span class="section-label">{c.pickLabel}</span>
        <h2 class="block-title">{c.pickHeading}</h2>
        <p class="block-text">{c.pickText}</p>

        <div class="chips" role="tablist" aria-label={c.pickHeading}>
          {c.bottlenecks.map((b, i) => (
            <button
              type="button"
              class:list={['chip', { active: i === 0 }]}
              role="tab"
              id={`tab-${i}`}
              aria-controls={`panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-tab={i}
            >{b.label}</button>
          ))}
        </div>

        {c.bottlenecks.map((b, i) => (
          <div
            class:list={['panel', { active: i === 0 }]}
            role="tabpanel"
            id={`panel-${i}`}
            aria-labelledby={`tab-${i}`}
            data-panel={i}
          >
            <div class="panel-col">
              <span class="mono panel-label">{c.buildLabel}</span>
              <p class="panel-text">{b.build}</p>
            </div>
            <div class="panel-col proof">
              <span class="mono panel-label">{c.proofLabel}</span>
              <p class="panel-text">{b.proof}</p>
              <a href={prefix + '/projects/' + b.project} class="panel-link">{projectTitle(b.project)} →</a>
            </div>
            <a href={mail(`${c.mailSubject}: ${b.label}`)} class="btn btn-accent panel-cta">{c.describeCta} <span aria-hidden="true">→</span></a>
          </div>
        ))}
      </section>

      <!-- What I bring -->
      <section class="block">
        <span class="section-label">{c.bringLabel}</span>
        <h2 class="block-title">{c.bringHeading}</h2>
        <div class="bring-grid">
          {c.bring.map((item, i) => (
            <div class="bring-card">
              <span class="mono num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="card-title">{item.title}</h3>
              <p class="card-text">{item.text}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- How I work -->
      <section class="block">
        <span class="section-label">{c.howLabel}</span>
        <h2 class="block-title">{c.howHeading}</h2>
        <ol class="how-list">
          {c.how.map((item, i) => (
            <li class="how-item">
              <span class="how-num">{i + 1}</span>
              <div>
                <h3 class="card-title">{item.title}</h3>
                <p class="card-text">{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- FAQ -->
      <section class="block">
        <span class="section-label">{c.faqLabel}</span>
        <h2 class="block-title">{c.faqHeading}</h2>
        <div class="faq">
          {c.faq.map((item) => (
            <details class="faq-item">
              <summary class="faq-q">{item.q}</summary>
              <p class="faq-a">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Closing CTA -->
      <section class="close">
        <h2 class="close-title">{c.closeHeading}</h2>
        <p class="close-text">{c.closeText}</p>
        <div class="cta-row">
          <a href={mail(c.mailSubject)} class="btn btn-accent">{about.email} <span aria-hidden="true">→</span></a>
          <a href={about.linkedin} target="_blank" rel="noopener" class="btn btn-light">{c.linkedinCta} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="close-links">
          <a href={prefix + '/intro'}>{c.moreIntro} →</a>
          <a href={prefix + '/#projects'}>{c.moreProjects} →</a>
        </div>
      </section>
    </div>
  </main>
  <footer class="footer">
    <div class="container">
      <p class="footer-text">{t['footer.copyright']}</p>
    </div>
  </footer>
</BaseLayout>

<script>
  // Tabs de "Elige tu cuello de botella". Sin JS, todos los paneles quedan visibles.
  const root = document.querySelector('[data-pick]');
  if (root) {
    root.classList.add('js');
    const tabs = root.querySelectorAll('[data-tab]');
    const panels = root.querySelectorAll('[data-panel]');

    const select = (index, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.classList.toggle('active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.setAttribute('tabindex', on ? '0' : '-1');
        if (on && focus) tab.focus();
      });
      panels.forEach((panel, i) => panel.classList.toggle('active', i === index));
    };

    tabs.forEach((tab, i) => {
      tab.setAttribute('tabindex', i === 0 ? '0' : '-1');
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  }
</script>

<style>
  .about-page {
    padding-top: calc(var(--nav-height) + 48px);
    padding-bottom: 80px;
  }
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    margin-bottom: 40px;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--color-accent);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* Hero */
  .hero-block {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 64px;
    align-items: center;
    margin-bottom: 72px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted-strong);
    margin-bottom: 20px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }
  .headline {
    font-family: var(--font-heading);
    font-size: clamp(36px, 5.5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin-bottom: 24px;
  }
  .lead {
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 640px;
    margin-bottom: 32px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-photo {
    position: relative;
  }
  .photo-frame {
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    background: var(--color-ink);
    overflow: hidden;
  }
  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .photo-badge {
    position: absolute;
    right: -12px;
    bottom: -12px;
    background: var(--color-accent);
    color: var(--color-ink);
    border-radius: 16px;
    padding: 12px 16px;
    font-weight: 800;
    font-size: 16px;
    line-height: 1.2;
    max-width: 80%;
  }

  /* Proof strip */
  .stats-block {
    margin-bottom: 96px;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 20px;
    color: var(--color-text);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .stat:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
  }
  .stat-value {
    font-family: var(--font-heading);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .stat-label {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .stats-source {
    margin-top: 12px;
    color: var(--color-muted-strong);
  }

  /* Blocks */
  .block {
    margin-bottom: 96px;
  }
  .block-title {
    font-family: var(--font-heading);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .block-text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 640px;
    margin-bottom: 28px;
  }

  /* Pick your bottleneck */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .chip {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    padding: 10px 18px;
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .chip:hover {
    background: var(--color-surface);
  }
  .chip.active {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .chip:focus-visible,
  .btn:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding: 32px;
    background: var(--color-ink);
    color: #F3F0E8;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .js .panel:not(.active) {
    display: none;
  }
  .panel-label {
    display: block;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .panel-text {
    font-size: 18px;
    line-height: 1.55;
    color: #E4E1D8;
  }
  .panel-link {
    display: inline-block;
    margin-top: 16px;
    font-weight: 700;
    color: var(--color-accent);
  }
  .panel-link:hover {
    text-decoration: underline;
  }
  .panel-cta {
    grid-column: 1 / -1;
    justify-self: start;
  }

  /* What I bring + How I work */
  .bring-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 28px;
  }
  .bring-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 28px;
  }
  .num {
    color: var(--color-accent-text);
    display: block;
    margin-bottom: 20px;
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .card-text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .how-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin-top: 28px;
    max-width: 760px;
  }
  .how-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    padding: 24px 0;
    border-top: 1px solid var(--color-border);
  }
  .how-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .how-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }

  /* FAQ */
  .faq {
    margin-top: 28px;
    max-width: 760px;
  }
  .faq-item {
    border-top: 1px solid var(--color-border);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-q {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-size: 18px;
    font-weight: 700;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--color-accent-text);
    transition: transform 0.2s ease;
  }
  .faq-item[open] .faq-q::after {
    transform: rotate(45deg);
  }
  .faq-a {
    padding: 0 0 22px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  /* Closing CTA */
  .close {
    background: var(--color-ink);
    color: #F3F0E8;
    border-radius: 28px;
    padding: clamp(32px, 6vw, 72px);
  }
  .close-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    max-width: 760px;
    margin-bottom: 16px;
  }
  .close-text {
    font-size: 18px;
    color: #C9C6BC;
    margin-bottom: 28px;
  }
  .btn-light {
    border-color: #F3F0E8;
    color: #F3F0E8;
  }
  .btn-light:hover {
    background: #F3F0E8;
    color: var(--color-ink);
  }
  .close-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .close-links a {
    color: #A8A59B;
    transition: color 0.2s ease;
  }
  .close-links a:hover {
    color: var(--color-accent);
  }

  .footer {
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
  }
  .footer-text {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted-strong);
  }

  @media (max-width: 860px) {
    .hero-block {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-photo {
      max-width: 320px;
    }
    .stats-grid,
    .bring-grid,
    .panel {
      grid-template-columns: 1fr;
    }
    .panel {
      padding: 24px;
    }
    .block {
      margin-bottom: 72px;
    }
  }
  @media (min-width: 861px) and (max-width: 1100px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
