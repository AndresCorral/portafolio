---
const t = Astro.props.t;
---

<section class="contact" id="contact">
  <div class="container">
    <span class="section-label">{t['nav.contact']}</span>
    <h2 class="contact-title">{t['contact.description']}</h2>
    <a class="contact-email" href="mailto:andresco70@gmail.com">{t['contact.email']}</a>
    <div class="contact-links">
      <a href="https://linkedin.com/in/andrescorral" target="_blank" rel="noopener" class="btn btn-light">
        {t['contact.linkedin']} <span aria-hidden="true">↗</span>
      </a>
      <a href="https://github.com/AndresCorral" target="_blank" rel="noopener" class="btn btn-light">
        {t['contact.github']} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-ink);
    color: #F3F0E8;
    padding: 120px 0 96px;
  }
  .contact .section-label {
    color: var(--color-accent);
  }
  .contact-title {
    font-family: var(--font-heading);
    font-size: clamp(44px, 8vw, 88px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    max-width: 960px;
    margin-bottom: 36px;
  }
  .contact-email {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, 44px);
    font-weight: 700;
    color: var(--color-accent);
    border-bottom: 3px solid var(--color-accent);
    padding-bottom: 4px;
    margin-bottom: 40px;
    word-break: break-all;
  }
  .contact-email:hover {
    color: #FFFFFF;
    border-color: #FFFFFF;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .btn-light {
    border-color: #F3F0E8;
    color: #F3F0E8;
  }
  .btn-light:hover {
    background: #F3F0E8;
    color: var(--color-ink);
  }
</style>
