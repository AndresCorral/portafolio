---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import { intro } from '../data/intro';
import { getProjectBySlug } from '../data/projects';

const { lang, t } = Astro.props;
const content = intro[lang];
const prefix = lang === 'es' ? '/es' : '';
const related = intro.related.map(getProjectBySlug).filter(Boolean);
---

<BaseLayout title={content.title} description={content.subtitle}>
  <Nav {t} lang={lang} />
  <main class="intro-page">
    <div class="container">
      <a href={prefix + '/'} class="back-link">← {content.back}</a>

      <header class="intro-header">
        <div class="intro-meta-top">
          <span class="intro-label">{content.label}</span>
        </div>
        <h1 class="intro-title">{content.title}</h1>
        <p class="intro-subtitle">{content.subtitle}</p>
      </header>

      {content.sections.map((section) => (
        <section class="intro-section">
          <h2 class="section-heading">{section.heading}</h2>
          {section.paragraphs && section.paragraphs.map((p) => <p class="intro-text">{p}</p>)}
          {section.items && (
            <ul class="results-list">
              {section.items.map((item) => <li class="result-item"><strong>{item.lead}</strong> {item.text}</li>)}
            </ul>
          )}
        </section>
      ))}

      <section class="intro-section related">
        <h2 class="section-heading">{content.relatedHeading}</h2>
        <div class="related-grid">
          {related.map((project) => (
            <a href={prefix + '/projects/' + project.slug} class="related-link">
              <span class="related-title">{project[lang].title}</span>
              <span class="related-role">{project.role[lang]} · {project.year}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  <footer class="footer">
    <div class="container">
      <p class="footer-text">{t['footer.copyright']}</p>
    </div>
  </footer>
</BaseLayout>

<style>
  .intro-page {
    padding-top: calc(var(--nav-height) + 48px);
    padding-bottom: 80px;
  }
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
    margin-bottom: 48px;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--color-accent);
  }
  .intro-header {
    margin-bottom: 56px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border);
  }
  .intro-meta-top {
    margin-bottom: 16px;
  }
  .intro-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted-strong);
  }
  .intro-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .intro-subtitle {
    font-size: 15px;
    color: var(--color-muted);
    line-height: 1.5;
    max-width: 720px;
  }
  .intro-section {
    margin-bottom: 56px;
    max-width: 720px;
  }
  .section-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 16px;
  }
  .intro-text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text);
  }
  .intro-text + .intro-text {
    margin-top: 16px;
  }
  .results-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .result-item {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text);
    padding-left: 20px;
    position: relative;
  }
  .result-item::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .related {
    max-width: none;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .related-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 24px;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .related-link:hover {
    border-color: var(--color-accent);
  }
  .related-title {
    font-family: var(--font-heading);
    font-size: 16px;
    color: var(--color-text);
  }
  .related-link:hover .related-title {
    color: var(--color-accent);
  }
  .related-role {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
  }
  .footer {
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
  }
  .footer-text {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted-strong);
  }

  @media (max-width: 860px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
